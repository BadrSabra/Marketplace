{
  "project_name": "Mit Gaber Hyperlocal Marketplace",
  "diagnostic_date": "2026-02-25",
  "database_analysis": {
    "tables": [
      {
        "name": "users",
        "columns": ["id", "name", "email", "password", "phone", "role", "isApproved", "transportType", "createdAt", "updatedAt"],
        "enums": ["role: ADMIN, CUSTOMER, STORE_OWNER, DRIVER"]
      },
      {
        "name": "wallets",
        "columns": ["id", "userId", "balance", "createdAt", "updatedAt"]
      },
      {
        "name": "ledger",
        "columns": ["id", "referenceId", "debitUserId", "creditUserId", "amount", "type", "createdAt", "updatedAt"]
      },
      {
        "name": "wallet_transactions",
        "columns": ["id", "walletId", "type", "amount", "relatedOrderId", "status", "createdAt"],
        "enums": ["transaction_type: DEPOSIT, WITHDRAWAL, REFUND, COMMISSION", "transaction_status: PENDING, COMPLETED, FAILED"]
      },
      {
        "name": "stores",
        "columns": ["id", "ownerId", "name", "type", "description", "locationText", "createdAt", "updatedAt"]
      },
      {
        "name": "products",
        "columns": ["id", "storeId", "name", "description", "price", "stock", "createdAt", "updatedAt"]
      },
      {
        "name": "orders",
        "columns": ["id", "customerId", "overallStatus", "deliveryStatus", "paymentStatus", "totalPrice", "createdAt", "updatedAt"],
        "enums": ["order_status: PENDING, ACCEPTED, IN_TRANSIT, DELIVERED, CANCELLED", "delivery_status: PENDING, ASSIGNED, PICKED_UP, DELIVERED", "payment_status: PENDING, PAID, REFUNDED, FAILED"]
      },
      {
        "name": "sub_orders",
        "columns": ["id", "orderId", "storeId", "status", "subtotal", "expectedDeliveryFee", "createdAt", "updatedAt"]
      },
      {
        "name": "order_items",
        "columns": ["id", "subOrderId", "productId", "quantity", "priceAtOrder"]
      },
      {
        "name": "delivery_offers",
        "columns": ["id", "subOrderId", "driverId", "offeredFee", "status", "createdAt", "updatedAt"],
        "enums": ["offer_status: PENDING, ACCEPTED, REJECTED, COUNTERED"]
      },
      {
        "name": "delivery_otps",
        "columns": ["id", "orderId", "subOrderId", "otpCode", "status", "createdAt", "updatedAt"]
      }
    ],
    "bootstrap_logic": "Admin account and seed data initialized in server/routes.ts via ensureAdminAccount() and seedDatabase()."
