      "wallet": ["GET /api/wallet", "POST /api/wallet/deposit", "POST /api/wallet/deposits/:id/approve (Admin)"],
      "delivery": ["POST /api/delivery/offers (Driver)", "POST /api/delivery/offers/:id/accept (Customer)", "POST /api/delivery/otp/generate", "POST /api/delivery/otp/verify"]
    }
  },
  "core_systems": {
