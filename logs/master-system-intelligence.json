{
  "project_overview": {
    "project_type": "Full-stack Monorepo (Express + Vite + React)",
    "frontend_framework": "React 18.3, Tailwind CSS 3.4/4.1, Wouter, TanStack Query v5",
    "backend_framework": "Express 5.0",
    "database": "PostgreSQL (Neon/Local via Drizzle)",
    "orm": "Drizzle ORM",
    "auth_system": "Custom JWT (jsonwebtoken + bcryptjs)",
    "folder_tree": {
      "client": {
        "src": ["components", "hooks", "lib", "pages", "locales", "i18n"]
      },
      "server": {
        "modules": ["audit", "delivery", "deposits", "ledger", "orders", "wallet"],
        "middleware": ["auth", "security"]
      },
      "shared": ["schema.ts", "routes.ts", "deposits.schema.ts"]
    }
  },
  "api_surface": {
    "endpoints": [
      { "method": "POST", "path": "/api/auth/register", "requires_auth": false, "request_shape": "registerSchema" },
      { "method": "POST", "path": "/api/auth/login", "requires_auth": false, "request_shape": "loginSchema" },
      { "method": "GET", "path": "/api/auth/me", "requires_auth": true },
      { "method": "GET", "path": "/api/customer/profile", "requires_auth": true, "role_required": "CUSTOMER" },
      { "method": "PATCH", "path": "/api/customer/profile", "requires_auth": true, "role_required": "CUSTOMER" },
      { "method": "GET", "path": "/api/users", "requires_auth": true, "role_required": "ADMIN" },
      { "method": "GET", "path": "/api/stores", "requires_auth": false },
      { "method": "POST", "path": "/api/stores", "requires_auth": true, "role_required": ["ADMIN", "STORE_OWNER"] },
      { "method": "GET", "path": "/api/products", "requires_auth": false },
      { "method": "POST", "path": "/api/products", "requires_auth": true },
      { "method": "PATCH", "path": "/api/suborders/:id/status", "requires_auth": true, "role_required": ["STORE_OWNER", "DRIVER", "ADMIN"] },
      { "method": "GET", "path": "/api/admin/stats", "requires_auth": true, "role_required": "ADMIN" },
      { "method": "GET", "path": "/api/wallet", "requires_auth": true },
      { "method": "POST", "path": "/api/wallet/deposit", "requires_auth": true }
    ]
  },
  "database_mapping": {
    "tables": ["users", "wallets", "ledger", "wallet_transactions", "stores", "products", "orders", "sub_orders", "order_items", "delivery_offers", "ratings", "delivery_otps", "audit_logs"],
    "order_status_flow": ["PENDING", "ACCEPTED", "IN_TRANSIT", "DELIVERED", "CANCELLED"],
    "wallet_rules": ["Ledger-based double-entry", "Admin override capability", "Commission/Refund/Deposit/Withdrawal types"],
    "relations": ["User -> Wallet (1:1)", "User -> Store (1:N)", "Store -> Product (1:N)", "Order -> SubOrder (1:N)", "SubOrder -> OrderItem (1:N)"]
  },
  "frontend_map": {
    "pages": ["LoginPage", "RegisterPage", "AdminDashboard", "CustomerDashboard", "StoreDashboard", "DriverDashboard", "CustomerWallet", "StoreInventory"],
    "role_restricted_views": ["Admin/*", "Customer/*", "Store/*", "Driver/*"],
    "providers": ["QueryClientProvider", "TooltipProvider", "AuthProvider (implicit via useAuth)"]
  },
  "rtl_risk_scan": {
    "high_risk_components": ["client/src/components/ui/table.tsx", "client/src/components/ui/toast.tsx", "client/src/components/ui/alert-dialog.tsx"],
    "alignment_conflicts": ["text-left", "text-right", "ml-auto", "pl-8", "pr-8", "left-4", "right-2"],
    "estimated_rtl_breakage": "MEDIUM"
  },
  "wallet_integrity": {
    "wallet_update_points": ["server/routes.ts (Register)", "server/modules/wallet/wallet.service.ts", "server/modules/wallet/wallet.controller.ts"],
    "order_status_update_points": ["server/modules/orders/order.controller.ts", "server/modules/orders/suborder.controller.ts"],
    "admin_override_points": ["app.patch('/api/admin/wallets/:walletId/override')"]
  },
  "complexity_scores": {
    "localization_complexity": 7,
    "rtl_complexity": 6,
    "safe_starting_page": "Auth Pages (Login/Register)",
    "suggested_rollout": ["1. Auth Pages", "2. Common UI Components", "3. Customer Dashboard", "4. Store/Driver Dashboards", "5. Admin Panel"]
  }
}
